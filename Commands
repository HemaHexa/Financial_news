        news = json.loads(row["raw_json"])
        source = str(news.get("source", "Unknown"))[:19]
        headline = str(news.get("headline", "No headline"))[:64]
        print(f"{i:<5} {source:<20} {headline:<65}")
    except Exception:
        print(f"{i:<5} Could not parse raw JSON")

print("=" * 110)
