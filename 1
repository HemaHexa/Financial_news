
import feedparser
import requests
from datetime import datetime, timezone

# RSS feed URLs
RSS_FEEDS = {
    "Business Standard": "https://www.business-standard.com/rss/latest.rss",
    "Moneycontrol": "https://www.moneycontrol.com/rss/latestnews.xml",
    "CNBC-TV18": "https://www.cnbctv18.com/commonfeeds/v1/cne/rss/market.xml",
    "Mint": "https://www.livemint.com/rss/marketsRSS"
}


def fetch_rss_news(source, feed_url):
    """Fetch raw news items from one RSS publisher."""

    headers = {
        "User-Agent": "Mozilla/5.0 (compatible; FinanceNewsPipeline/1.0)"
    }

    try:
        response = requests.get(
            feed_url,
            headers=headers,
            timeout=20
        )
        response.raise_for_status()

        feed = feedparser.parse(response.content)

        articles = []

        for entry in feed.entries:
            article = {
                "source": source,
                "headline": entry.get("title", ""),
                "url": entry.get("link", ""),
                "published_at": entry.get("published", ""),
                "description": entry.get("summary", ""),
                "raw_content": entry.get("content", []),
                "ingested_at": datetime.now(timezone.utc).isoformat()
            }

            articles.append(article)

        print(f"{source}: fetched {len(articles)} articles")

        return articles

    except requests.RequestException as error:
        print(f"{source}: RSS request failed - {error}")
        return []

    except Exception as error:
        print(f"{source}: processing failed - {error}")
        return []


def fetch_all_sources():
    """Fetch RSS news from all four publishers."""

    all_articles = []

    for source, feed_url in RSS_FEEDS.items():
        articles = fetch_rss_news(source, feed_url)
        all_articles.extend(articles)

    return all_articles


if __name__ == "__main__":
    news = fetch_all_sources()

    print("\nTotal articles fetched:", len(news))
    
