
import json
import time
import hashlib
import logging
from datetime import datetime, timezone

import truststore
truststore.inject_into_ssl()

import requests
import feedparser

from kafka import KafkaProducer
from kafka.errors import KafkaError


# ============================================================
# CONFIGURATION
# ============================================================

KAFKA_BOOTSTRAP_SERVERS = "localhost:9092"
KAFKA_TOPIC = "raw-news-events"

REFRESH_INTERVAL_SECONDS = 15 * 60
REQUEST_TIMEOUT = 30

RSS_FEEDS = {
    "Business Standard":
        "https://www.business-standard.com/rss/latest.rss",

    "Moneycontrol":
        "https://www.moneycontrol.com/rss/latestnews.xml",

    "CNBC-TV18":
        "https://www.cnbctv18.com/commonfeeds/v1/cne/rss/market.xml",

    "Mint":
        "https://www.livemint.com/rss/markets"
}

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                  "AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36"
}


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)

logger = logging.getLogger("FinancialNewsProducer")


# ============================================================
# HTTP SESSION
# ============================================================

session = requests.Session()
session.headers.update(HEADERS)


# ============================================================
# KAFKA PRODUCER
# ============================================================

def create_kafka_producer():

    try:
        producer = KafkaProducer(
            bootstrap_servers=KAFKA_BOOTSTRAP_SERVERS,

            value_serializer=lambda value: json.dumps(
                value,
                ensure_ascii=False,
                default=str
            ).encode("utf-8"),

            key_serializer=lambda key: (
                key.encode("utf-8") if key else None
            ),

            acks="all",
            retries=10,
            max_in_flight_requests_per_connection=1,
            request_timeout_ms=30000
        )

        logger.info("Connected to Kafka successfully.")

        return producer

    except KafkaError:

        logger.exception("Kafka connection failed.")

        raise


# ============================================================
# ARTICLE ID
# ============================================================

def generate_article_id(url, headline):

    unique_value = url or headline

    return hashlib.sha256(
        unique_value.encode("utf-8")
    ).hexdigest()


# ============================================================
# FETCH RSS FROM ONE SOURCE
# ============================================================

def fetch_rss_news(source, feed_url):

    logger.info("Fetching RSS from %s", source)

    try:

        response = session.get(
            feed_url,
            timeout=REQUEST_TIMEOUT
        )

        response.raise_for_status()

        feed = feedparser.parse(response.content)

        if feed.bozo:
            logger.warning(
                "%s RSS parsing warning: %s",
                source,
                feed.bozo_exception
            )

        articles = []

        for entry in feed.entries:

            headline = entry.get("title", "")
            url = entry.get("link", "")

            if not headline or not url:
                continue

            article = {
                "article_id": generate_article_id(
                    url,
                    headline
                ),

                "source": source,

                "headline": headline,

                "url": url,

                "published_at": entry.get(
                    "published",
                    entry.get("updated", "")
                ),

                "description": entry.get(
                    "summary",
                    ""
                ),

                "raw_content": entry.get(
                    "content",
                    []
                ),

                "raw_rss_entry": dict(entry),

                "ingested_at": datetime.now(
                    timezone.utc
                ).isoformat()
            }

            articles.append(article)

        logger.info(
            "%s: fetched %d articles",
            source,
            len(articles)
        )

        return articles

    except requests.RequestException:

        logger.exception(
            "%s RSS request failed",
            source
        )

        return []

    except Exception:

        logger.exception(
            "Unexpected RSS error from %s",
            source
        )

        return []


# ============================================================
# FETCH ALL FOUR PUBLISHERS
# ============================================================

def fetch_all_sources():

    all_articles = []

    for source, feed_url in RSS_FEEDS.items():

        articles = fetch_rss_news(
            source,
            feed_url
        )

        all_articles.extend(articles)

    logger.info(
        "Total RSS articles collected: %d",
        len(all_articles)
    )

    return all_articles


# ============================================================
# PUBLISH RAW NEWS TO KAFKA
# ============================================================

def publish_to_kafka(producer, articles):

    published_count = 0
    failed_count = 0

    for article in articles:

        try:

            future = producer.send(
                KAFKA_TOPIC,
                key=article["article_id"],
                value=article
            )

            metadata = future.get(timeout=30)

            published_count += 1

            logger.info(
                "Published | Source: %s | Partition: %s | Offset: %s",
                article["source"],
                metadata.partition,
                metadata.offset
            )

        except Exception:

            failed_count += 1

            logger.exception(
                "Kafka publishing failed for: %s",
                article.get("headline", "Unknown article")
            )

    producer.flush()

    logger.info("-----------------------------------")
    logger.info("Kafka publishing completed.")
    logger.info("Published: %d", published_count)
    logger.info("Failed: %d", failed_count)
    logger.info("-----------------------------------")

    return published_count, failed_count


# ============================================================
# ONE COLLECTION CYCLE
# ============================================================

def run_collection_cycle(producer, cycle_type):

    logger.info("===================================")
    logger.info("Starting %s collection", cycle_type)
    logger.info("===================================")

    started_at = datetime.now(timezone.utc)

    # Fetch all four RSS feeds.
    articles = fetch_all_sources()

    # Publish every fetched article.
    # No deduplication or company matching here.
    if articles:

        published, failed = publish_to_kafka(
            producer,
            articles
        )

    else:

        published = 0
        failed = 0

        logger.warning("No articles collected in this cycle.")

    completed_at = datetime.now(timezone.utc)

    logger.info("Collection cycle completed.")
    logger.info("Cycle type: %s", cycle_type)
    logger.info("Fetched: %d", len(articles))
    logger.info("Published: %d", published)
    logger.info("Failed: %d", failed)
    logger.info("Started: %s", started_at.isoformat())
    logger.info("Completed: %s", completed_at.isoformat())

    return published, failed


# ============================================================
# MAIN SCHEDULER
# ============================================================

def main():

    producer = None

    try:

        logger.info("Starting Financial News Pipeline")
        logger.info("Kafka topic: %s", KAFKA_TOPIC)
        logger.info("Refresh interval: 15 minutes")

        # Connect to Kafka.
        producer = create_kafka_producer()

        # FIRST RUN: INITIAL BASELINE.
        run_collection_cycle(
            producer,
            cycle_type="INITIAL BASELINE"
        )

        # CONTINUOUS RUN: EVERY 15 MINUTES.
        while True:

            logger.info(
                "Next RSS refresh in 15 minutes."
            )

            time.sleep(
                REFRESH_INTERVAL_SECONDS
            )

            run_collection_cycle(
                producer,
                cycle_type="PERIODIC REFRESH"
            )

    except KeyboardInterrupt:

        logger.info(
            "Producer stopped by user."
        )

    except Exception:

        logger.exception(
            "Producer encountered a fatal error."
        )

    finally:

        if producer is not None:

            producer.flush()
            producer.close()

        session.close()

        logger.info(
            "Financial News Producer stopped."
        )


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    main()
    
