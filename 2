# ==================================================
# 4. PRECOMPILE COMPANY SEARCH PATTERNS
# ==================================================

COMPANY_PATTERNS = {}

for company, aliases in COMPANY_ALIASES.items():

    COMPANY_PATTERNS[company] = [
        re.compile(
            r"(?<![A-Za-z0-9])"
            + re.escape(alias)
            + r"(?![A-Za-z0-9])",
            re.IGNORECASE
        )
        for alias in aliases
    ]


