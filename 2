
from pathlib import Path
import pandas as pd
import pyarrow.parquet as pq

ROOT = Path(__file__).resolve().parent
BRONZE_DIR = ROOT / "data" / "bronze" / "news_history"

EXPECTED_COLUMNS = [
    "kafka_key",
    "raw_json",
    "topic",
    "partition",
    "offset",
    "kafka_ts"
]

def main():

    files = list(BRONZE_DIR.rglob("*.parquet"))

    if not files:
        print("No Parquet files found.")
        return

    frames = []

    for file in files:
        table = pq.read_table(file)
        frames.append(table.to_pandas())

    df = pd.concat(frames, ignore_index=True)

    # Verify Bronze schema
    missing = set(EXPECTED_COLUMNS) - set(df.columns)

    if missing:
        print("Missing Bronze columns:", missing)
        return

    df = df[EXPECTED_COLUMNS]

    print("\n========== BRONZE PARQUET TABLE ==========")
    print("Total records:", len(df))
    print("Total files:", len(files))

    pd.set_option("display.max_columns", None)
    pd.set_option("display.max_colwidth", 100)
    pd.set_option("display.width", 250)

    print(df.to_string(index=False))

    # Save table for opening in Excel
    output = ROOT / "data" / "bronze" / "bronze_table.csv"
    df.to_csv(output, index=False, encoding="utf-8-sig")

    print("\nBronze table saved:", output)


if __name__ == "__main__":
    main()
    
