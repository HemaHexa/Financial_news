
import requests
from bs4 import BeautifulSoup

URL = "https://www.business-standard.com/companies/news"

response = requests.get(
    URL,
    headers={"User-Agent": "Mozilla/5.0"},
    timeout=20
)
response.raise_for_status()

soup = BeautifulSoup(response.text, "html.parser")

print("========== ARTICLE DATE METADATA ==========")

for tag in soup.find_all("meta"):
    key = tag.get("property") or tag.get("name", "")
    value = tag.get("content", "")

    if any(word in key.lower() for word in [
        "published", "date", "modified"
    ]):
        print(key, ":", value)

print("\n========== RELIANCE ARTICLE LINKS ==========")

for link in soup.find_all("a", href=True):
    headline = link.get_text(" ", strip=True)

    if "reliance" in headline.lower():
        print("Headline:", headline)
        print("URL:", link["href"])

print("\n========== DATE-LIKE TEXT ==========")

for text in soup.find_all(string=True):
    value = text.strip()

    if "November" in value or "2026" in value:
        if len(value) < 150:
            print(value)
